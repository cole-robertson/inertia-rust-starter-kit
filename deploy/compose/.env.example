# Copy to deploy/compose/.env (git-ignored) and fill in. docs/DEPLOY.md lists every setting.

# Required. bin/secret prints one (>= 64 chars).
SECRET_KEY_BASE=
# Required: the public https URL, used in mail links and the CSRF origin check.
HOST=https://app.example.com

# Mail (verification, password reset, invitations). Unset MAILER_HOST: the app runs but sends no mail.
MAILER_HOST=
MAILER_USER=
MAILER_PASSWORD=
# MAILER_PORT=587
MAIL_FROM=app@example.com

# With `--profile tls`: the domain Caddy gets a certificate for (HOST's host).
DOMAIN=app.example.com

# Without Caddy: where the app is published for your own proxy (default 127.0.0.1:8080).
# APP_BIND=127.0.0.1
# APP_PORT=8080
