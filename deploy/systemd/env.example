# /etc/inertia-rust-starter-kit/env (mode 600, root-owned). docs/DEPLOY.md lists every setting.

# Required. bin/secret prints one (>= 64 chars).
SECRET_KEY_BASE=
# Required: the public https URL the reverse proxy serves.
HOST=https://app.example.com

# Mail. Unset MAILER_HOST: the app runs but sends no mail.
MAILER_HOST=
MAILER_USER=
MAILER_PASSWORD=
MAIL_FROM=app@example.com
