# Settings for deploy/cloudflare/deploy.sh. Copy to deploy/cloudflare/.env.local (git-ignored)
# and fill in; a variable already set in the environment wins over the file. Shell syntax:
# quote values with spaces or shell characters.

# The Cloudflare account that owns the zone (dashboard > account home, or `cf accounts list`).
CF_ACCOUNT_ID=your-account-id
# The Worker's custom domain, in a zone on that account. The app's HOST is https://<this>.
CF_DOMAIN=app.example.com

# Optional, for a public demo only: a user created (or its password reset) at every boot.
# Set both or neither; leave them out for a real app.
# DEMO_ADMIN_EMAIL=admin@example.com
# DEMO_ADMIN_PASSWORD='a long demo password'
