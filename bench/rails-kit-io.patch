@@ -0,0 +1,27 @@
+# frozen_string_literal: true
+
+# Benchmark-only endpoints (inertia-rust-starter-kit bench/rails-kit-io.patch). The Rust kit
+# serves the same three from src/controllers/bench.rs.
+class BenchController < ApplicationController
+  skip_forgery_protection
+  skip_before_action :authenticate
+
+  UPSTREAM = URI(ENV.fetch("BENCH_UPSTREAM_URL", "http://127.0.0.1:9900/slow?ms=100"))
+
+  # One HTTP GET to the mock upstream with stdlib Net::HTTP, like the app's API clients.
+  def upstream
+    res = Net::HTTP.get_response(UPSTREAM)
+    raise "upstream answered #{res.code}" unless res.is_a?(Net::HTTPSuccess)
+
+    render json: { ok: true, upstream: JSON.parse(res.body) }
+  end
+
+  def write
+    event = BenchEvent.create!(payload: params.require(:payload))
+    render json: { ok: true, id: event.id }
+  end
+
+  def read
+    render json: { ok: true, count: BenchEvent.count, latest: BenchEvent.order(id: :desc).limit(20) }
+  end
+end
