diff --git a/app/controllers/inertia_controller.rb b/app/controllers/inertia_controller.rb
index 64c6abb..5aa6f58 100644
--- a/app/controllers/inertia_controller.rb
+++ b/app/controllers/inertia_controller.rb
@@ -1,9 +1,39 @@
 # frozen_string_literal: true
 
+# Hand-written Inertia protocol (what inertia_rails does for these pages):
+# an XHR visit gets the page object as JSON, a full visit gets it inside the
+# HTML shell. Shared props match the kit: errors + auth.user + auth.session.
 class InertiaController < ApplicationController
-  inertia_config default_render: true
-  inertia_share auth: {
-        user: -> { Current.user.as_json(only: %i[id name email verified created_at updated_at]) },
-        session: -> { Current.session.as_json(only: %i[id]) }
-      }
+  ASSET_VERSION = "816e418b77453e34d00fd7af7b186aa6"
+
+  private
+
+  # Actions call render themselves (not from a helper): Roundhouse appends an
+  # implicit head(:no_content) to any action whose body has no literal render.
+  def inertia_page(component)
+    {
+      component: component,
+      props: { errors: {}, auth: { user: auth_user, session: auth_session } },
+      url: request.fullpath,
+      version: ASSET_VERSION,
+      encryptHistory: true,
+      clearHistory: false,
+      sharedProps: [ "errors", "auth" ]
+    }.to_json
+  end
+
+  def auth_user
+    user = Current.user
+    return nil if user.nil?
+
+    { id: user.id, name: user.name, email: user.email, verified: user.verified,
+      created_at: user.created_at.utc.iso8601(3), updated_at: user.updated_at.utc.iso8601(3) }
+  end
+
+  def auth_session
+    session_record = Current.session
+    return nil if session_record.nil?
+
+    { id: session_record.id }
+  end
 end
